rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*admin.*') ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    
    function isMechanic() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mechanic'
      );
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();
    }

    // 2. Mechanic Shops
    match /shops/{shopId} {
      allow read: if true; // Publicly discoverable by nearby motorists
      allow create, update: if isAuthenticated() && (
        resource == null || 
        resource.data.ownerUid == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 3. Repair Requests
    match /requests/{requestId} {
      // Motorist can read their own request; Mechanics can read open searching requests or assigned jobs; Admin can read all
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.status == 'searching' ||
        resource.data.shopId == request.auth.uid ||
        isAdmin()
      );
      
      // Motorists can create requests
      allow create: if isAuthenticated();
      
      // Updates: Status updates by assigned mechanic, user ratings/cancellations, or admin
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.shopId == request.auth.uid ||
        resource.data.status == 'searching' ||
        isAdmin()
      );
      
      allow delete: if isAdmin();

      // Nested Chat Messages
      match /messages/{messageId} {
        allow read, create: if isAuthenticated() && (
          get(/databases/$(database)/documents/requests/$(requestId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/requests/$(requestId)).data.shopId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // 4. Payments (Read only by participants; Mutated only by verified server functions / Admin)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.shopId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // 5. Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}
